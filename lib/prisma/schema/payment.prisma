model Payment {
    id                       String                 @id @default(cuid())
    orderId                  String                 @unique
    order                    Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
    amount                   Decimal                @default(0.00)
    currency                 String
    method                   PaymentMethod
    status                   PaymentStatus
    phoneNumber              String?
    mobileNetwork            PaymentNetwork?
    transactionId            String?
    transactionReference     String?
    metadata                 Json?
    paymentGatewaySettingsId String
    paymentGatewaySettings   PaymentGatewaySettings @relation(fields: [paymentGatewaySettingsId], references: [id], onDelete: Restrict) // Changed to Restrict
    createdAt                DateTime               @default(now())
    updatedAt                DateTime               @updatedAt
}

model PaymentGatewaySettings {
    id                String          @id @default(cuid())
    name              String
    environment       Environment
    apiKey            String
    apiSecret         String
    webhookSecret     String?
    supportedMethods  PaymentMethod[]
    supportedNetworks PaymentNetwork[]
    payments          Payment[]
    createdAt         DateTime        @default(now())
    updatedAt         DateTime        @updatedAt
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
    REFUNDED
    AWAITING_CONFIRMATION
}

enum PaymentMethod {
    MOBILE_MONEY
    PAYMENT_ON_DELIVERY
    CARD
}

enum Environment {
    TEST
    LIVE
}

enum PaymentNetwork {
    MTN
    AIRTELTIGO
    TELECEL
}

